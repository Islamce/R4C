NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
DATABASE_URL=postgresql://r4c:r4c_dev@localhost:5432/r4c
# Prisma migration tooling uses the direct connection; local development uses the same instance.
DIRECT_URL=postgresql://r4c:r4c_dev@localhost:5432/r4c
REDIS_URL=redis://localhost:6379
# Required C04 expiry sweep cadence; this is deployment configuration, not a runtime default.
HOLD_EXPIRY_SWEEP_INTERVAL_MS=300000
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://host.docker.internal:9000
S3_REGION=us-east-1
S3_BUCKET=r4c
S3_ACCESS_KEY=r4c
S3_SECRET_KEY=change-me-now
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
# Frozen Development Intelligence is disabled unless a developer explicitly opts in.
BIM_ENABLED=false
BIM_WORKER_URL=http://localhost:8000
BIM_WORKER_TOKEN=replace-with-at-least-32-random-characters
BIM_MAX_ELEMENTS=250000
BIM_MAX_FILE_BYTES=1073741824
BIM_ALLOWED_SOURCE_HOSTS=host.docker.internal
API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:3000
TENANT_BASE_DOMAIN=r4c.local
TENANT_DEFAULT_CODE=ALOMRAN
SEED_TENANT_CODE=R4C
SEED_TENANT_NAME=R4C Bootstrap Tenant
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=SET_A_SECURE_VALUE_WITH_12_OR_MORE_CHARACTERS
SEED_UAT_TENANT_CODE=ALOMRAN
SEED_UAT_TENANT_NAME=Alomran Development
SEED_UAT_TENANT_NAME_AR=العمران للتطوير العقاري
SEED_UAT_ADMIN_EMAIL=uat.admin@alomran.test
SEED_UAT_ADMIN_PASSWORD=SET_A_SECURE_VALUE_WITH_12_OR_MORE_CHARACTERS
SEED_UAT_SUBMIT_EMAIL=uat.submit@alomran.test
SEED_UAT_SUBMIT_DISPLAY_NAME=Alomran UAT Progress Submitter
SEED_UAT_SUBMIT_PASSWORD=SET_A_DIFFERENT_SECURE_VALUE_WITH_12_OR_MORE_CHARACTERS
SEED_UAT_SALES_AGENT_EMAIL=uat.sales-agent@alomran.test
SEED_UAT_SALES_AGENT_PASSWORD=SET_A_DIFFERENT_SECURE_VALUE_WITH_12_OR_MORE_CHARACTERS
SEED_UAT_SALES_MANAGER_EMAIL=uat.sales-manager@alomran.test
SEED_UAT_SALES_MANAGER_PASSWORD=SET_A_DIFFERENT_SECURE_VALUE_WITH_12_OR_MORE_CHARACTERS
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_AUTH_SESSION_PER_MINUTE=20
RATE_LIMIT_TENANT_LOOKUP_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_SEARCH_EXPORT_PER_MINUTE=30
TRUST_PROXY_HOPS=1
