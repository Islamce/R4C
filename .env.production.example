# Copy this file to .env.production, then run scripts/generate-production-env.sh.
# Never commit .env.production. Keep it chmod 600 on the VPS.

# Runtime mode and internal container ports.
NODE_ENV=production
WEB_PORT=3000
API_PORT=4000

# Public hostnames. Replace example.com before deployment.
# APP_DOMAIN is the main browser entry point.
# TENANT_BASE_DOMAIN is also the suffix for tenant hosts such as alomran.r4c.example.com.
APP_DOMAIN=r4c.example.com
API_DOMAIN=api.r4c.example.com
TENANT_BASE_DOMAIN=r4c.example.com
ACME_EMAIL=owner@example.com

# Production uses the Cloudflare DNS-01 provider for wildcard TLS.
# Create a restricted token with Zone:Read and DNS:Edit for this zone only.
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_DNS_TOKEN
CADDYFILE=Caddyfile

# PostgreSQL. The generator replaces the password placeholder with a strong hex value.
POSTGRES_USER=r4c
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_PASSWORD
POSTGRES_DB=r4c
DATABASE_URL=postgresql://r4c:REPLACE_WITH_GENERATED_POSTGRES_PASSWORD@postgres:5432/r4c?schema=public

# Redis authentication and internal URL.
REDIS_PASSWORD=REPLACE_WITH_GENERATED_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_GENERATED_REDIS_PASSWORD@redis:6379
# Required C04 expiry sweep cadence; set deliberately at deployment and do not rely on a code default.
HOLD_EXPIRY_SWEEP_INTERVAL_MS=300000

# Private MinIO object storage. Access and root credentials intentionally match.
MINIO_ROOT_USER=REPLACE_WITH_GENERATED_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_GENERATED_MINIO_SECRET_KEY
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=r4c-production
S3_ACCESS_KEY=REPLACE_WITH_GENERATED_MINIO_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_GENERATED_MINIO_SECRET_KEY

# Authentication secrets. Each must be independent and randomly generated.
JWT_ACCESS_SECRET=REPLACE_WITH_GENERATED_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_GENERATED_JWT_REFRESH_SECRET

# BIM worker is private and reachable only on the Docker backend network.
BIM_WORKER_URL=http://bim-worker:8000
BIM_WORKER_TOKEN=REPLACE_WITH_GENERATED_BIM_WORKER_TOKEN
BIM_MAX_ELEMENTS=250000
BIM_MAX_FILE_BYTES=1073741824
BIM_ALLOWED_SOURCE_HOSTS=minio

# Next.js uses API_URL server-side over the private network.
# NEXT_PUBLIC_API_URL is the browser-visible HTTPS API URL baked into the web image.
API_URL=http://api:4000/api/v1
NEXT_PUBLIC_API_URL=https://api.r4c.example.com/api/v1

# Exact allowed browser origins. Add each tenant host used for direct API calls.
CORS_ORIGINS=https://r4c.example.com,https://alomran.r4c.example.com

# Tenant resolution.
TENANT_DEFAULT_CODE=ALOMRAN

# Optional bootstrap tenant used for platform administration.
SEED_TENANT_CODE=R4C
SEED_TENANT_NAME="R4C Production Tenant"
SEED_ADMIN_EMAIL=platform.admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_BOOTSTRAP_ADMIN_PASSWORD

# Alomran UAT tenant and administrator.
SEED_UAT_TENANT_CODE=ALOMRAN
SEED_UAT_TENANT_NAME="Alomran Development"
SEED_UAT_TENANT_NAME_AR="العمران للتطوير العقاري"
SEED_UAT_ADMIN_EMAIL=uat.admin@alomran.example.com
SEED_UAT_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_UAT_ADMIN_PASSWORD

# Separation-of-duties UAT user. Receives VIEWER-derived permissions plus progress:submit only.
SEED_UAT_SUBMIT_EMAIL=uat.submit@alomran.example.com
SEED_UAT_SUBMIT_DISPLAY_NAME="Alomran UAT Progress Submitter"
SEED_UAT_SUBMIT_PASSWORD=REPLACE_WITH_GENERATED_UAT_SUBMIT_PASSWORD

# Production request limits. Adjust only after observing real traffic.
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_AUTH_SESSION_PER_MINUTE=20
RATE_LIMIT_TENANT_LOOKUP_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_SEARCH_EXPORT_PER_MINUTE=30

# Exactly one trusted reverse proxy hop: Caddy -> API.
TRUST_PROXY_HOPS=1
