{
  "name": "@r4c/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:e2e": "node --test test/http-e2e.mjs",
    "test:c02": "pnpm build && node --test test/c02-*.mjs",
    "test:c03": "pnpm build && node --test test/c03-http-e2e.mjs test/c03-invariants-e2e.mjs",
    "test:c04": "pnpm build && node --test test/c04-i18n-holds-reservations-e2e.mjs",
    "test:bim-disabled": "pnpm build && node --test test/bim-disabled-bootstrap-e2e.mjs",
    "test:seed": "node --test test/seed-e2e.mjs",
    "test:rate-limit": "node --test test/rate-limit-e2e.mjs",
    "test:auth-session": "node --test test/auth-session-e2e.mjs",
    "seed": "tsx prisma/seed.ts",
    "seed:uat": "tsx prisma/seed-uat.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "hash-wasm": "4.12.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
