  updatedAt     DateTime               @updatedAt
  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspection    QualityInspection?     @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  wbsNode       WbsNode                @relation(fields: [wbsNodeId], references: [id], onDelete: Restrict)
  bimElement    BimElement?            @relation(fields: [bimElementId], references: [id], onDelete: SetNull)
  raisedBy      User                   @relation("FindingRaiser", fields: [raisedById], references: [id], onDelete: Restrict)
  closedBy      User?                  @relation("FindingCloser", fields: [closedById], references: [id], onDelete: Restrict)
  actions       QualityAction[]
  evidence      QualityEvidence[]

  @@unique([projectId, externalId])
  @@index([tenantId, projectId, status, severity])
  @@index([inspectionId])
  @@index([wbsNodeId, status])
  @@index([bimElementId, status])
}

model QualityAction {
  id            String              @id @default(uuid())
  tenantId      String
  findingId     String
  description   String
  assignedToId  String
  dueAt         DateTime
  status        QualityActionStatus @default(OPEN)
  completedById String?
  completedAt   DateTime?
  completionNote String?
  verifiedById  String?
  verifiedAt    DateTime?
  verificationNote String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  finding       QualityFinding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  assignedTo    User                @relation("QualityActionAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  completedBy   User?               @relation("QualityActionCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  verifiedBy    User?               @relation("QualityActionVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([tenantId, findingId, status])
  @@index([assignedToId, status, dueAt])
}

model QualityEvidence {
  id                String           @id @default(uuid())
  tenantId          String
  inspectionId      String?
  findingId         String?
  documentVersionId String
  addedById         String
  note              String?
  createdAt         DateTime         @default(now())
  inspection        QualityInspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  finding           QualityFinding?    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion    @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  addedBy           User               @relation("QualityEvidenceAdder", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([inspectionId, documentVersionId])
  @@unique([findingId, documentVersionId])
  @@index([tenantId, inspectionId])
  @@index([tenantId, findingId])
}


model SafetyPermit {
  id            String             @id @default(uuid())
  tenantId      String
  projectId     String
  wbsNodeId     String
  bimElementId  String?
  externalId    String
  type          SafetyPermitType
  status        SafetyPermitStatus @default(DRAFT)
  title         String
  description   String
  riskAssessment String
  controls      String
  validFrom     DateTime
  validUntil    DateTime
  requestedById String
  reviewedById  String?
  activatedById String?
  closedById    String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  activatedAt   DateTime?
  suspendedAt   DateTime?
  closedAt      DateTime?
  reviewComment String?
  closeNote     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode       WbsNode            @relation(fields: [wbsNodeId], references: [id], onDelete: Restrict)
  bimElement    BimElement?        @relation(fields: [bimElementId], references: [id], onDelete: SetNull)
  requestedBy   User               @relation("SafetyPermitRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    User?              @relation("SafetyPermitReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  activatedBy   User?              @relation("SafetyPermitActivator", fields: [activatedById], references: [id], onDelete: Restrict)
  closedBy      User?              @relation("SafetyPermitCloser", fields: [closedById], references: [id], onDelete: Restrict)
  evidence      SafetyEvidence[]

  @@unique([projectId, externalId])
  @@index([tenantId, projectId, status, validUntil])
  @@index([wbsNodeId, status])
  @@index([bimElementId, status])
}

model SafetyEvent {
  id               String            @id @default(uuid())
  tenantId         String
  projectId        String
  wbsNodeId        String
  bimElementId     String?
  externalId       String
  type             SafetyEventType
  severity         SafetySeverity
  status           SafetyEventStatus @default(OPEN)
  title            String
  description      String
  occurredAt       DateTime
  dueAt            DateTime?
  reportedById     String
  investigatedById String?
  closedById       String?
  investigationAt  DateTime?
  rootCause        String?
  immediateActions String?
  closedAt         DateTime?
  closureNote      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode          WbsNode           @relation(fields: [wbsNodeId], references: [id], onDelete: Restrict)
  bimElement       BimElement?       @relation(fields: [bimElementId], references: [id], onDelete: SetNull)
  reportedBy       User              @relation("SafetyEventReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  investigatedBy   User?             @relation("SafetyEventInvestigator", fields: [investigatedById], references: [id], onDelete: Restrict)
  closedBy         User?             @relation("SafetyEventCloser", fields: [closedById], references: [id], onDelete: Restrict)
  actions          SafetyAction[]
  evidence         SafetyEvidence[]

  @@unique([projectId, externalId])
  @@index([tenantId, projectId, status, severity])
  @@index([wbsNodeId, status])
  @@index([bimElementId, status])
  @@index([occurredAt])
}

model SafetyAction {
  id               String             @id @default(uuid())
  tenantId         String
  safetyEventId    String
  description      String
  assignedToId     String
  dueAt            DateTime
  status           SafetyActionStatus @default(OPEN)
  completedById    String?
  completedAt      DateTime?
  completionNote   String?
  verifiedById     String?
  verifiedAt       DateTime?
  verificationNote String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  safetyEvent      SafetyEvent        @relation(fields: [safetyEventId], references: [id], onDelete: Cascade)
  assignedTo       User               @relation("SafetyActionAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  completedBy      User?              @relation("SafetyActionCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  verifiedBy       User?              @relation("SafetyActionVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([tenantId, safetyEventId, status])
  @@index([assignedToId, status, dueAt])
}

model SafetyEvidence {
  id                String           @id @default(uuid())
  tenantId          String
  safetyPermitId    String?
  safetyEventId     String?
  documentVersionId String
  addedById         String
  note              String?
  createdAt         DateTime         @default(now())
  safetyPermit      SafetyPermit?    @relation(fields: [safetyPermitId], references: [id], onDelete: Cascade)
  safetyEvent       SafetyEvent?     @relation(fields: [safetyEventId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  addedBy           User             @relation("SafetyEvidenceAdder", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([safetyPermitId, documentVersionId])
  @@unique([safetyEventId, documentVersionId])
  @@index([tenantId, safetyPermitId])
  @@index([tenantId, safetyEventId])
}


model CommissioningPlan {
  id          String                  @id @default(uuid())
  tenantId    String
  projectId   String
  revision    String
  name        String
  status      CommissioningPlanStatus @default(DRAFT)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  project     Project                 @relation("ProjectCommissioningPlans", fields: [projectId], references: [id], onDelete: Cascade)
  activeFor   Project?                @relation("ActiveCommissioningPlan")
  createdBy   User                    @relation("CommissioningPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  checkpoints CommissioningCheckpoint[]

  @@unique([projectId, revision])
  @@index([tenantId, projectId, status])
}

model CommissioningCheckpoint {
  id                 String            @id @default(uuid())
  tenantId           String
  commissioningPlanId String
  wbsNodeId          String?
  code               String
  title              String
  system             String
  acceptanceCriteria String
  holdPoint          Boolean           @default(false)
  ifcType            String?
  sortOrder          Int               @default(0)
  commissioningPlan  CommissioningPlan @relation(fields: [commissioningPlanId], references: [id], onDelete: Cascade)
  wbsNode            WbsNode?          @relation(fields: [wbsNodeId], references: [id], onDelete: Restrict)
  tests              CommissioningTest[]

  @@unique([commissioningPlanId, code])
  @@index([tenantId, commissioningPlanId, sortOrder])
  @@index([wbsNodeId])
}

model CommissioningTest {
  id                 String                  @id @default(uuid())
  tenantId           String
  projectId          String
  checkpointId       String
  wbsNodeId          String
  bimElementId       String?
  externalId         String
  scheduledFor       DateTime
  status             CommissioningTestStatus @default(SCHEDULED)
  result             CommissioningTestResult?
  readings           Json?
  notes              String?
  performedById      String
  reviewedById       String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewComment      String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkpoint         CommissioningCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Restrict)
  wbsNode            WbsNode                 @relation(fields: [wbsNodeId], references: [id], onDelete: Restrict)
  bimElement         BimElement?             @relation(fields: [bimElementId], references: [id], onDelete: SetNull)
  performedBy        User                    @relation("CommissioningTestPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  reviewedBy         User?                   @relation("CommissioningTestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  evidence           CommissioningEvidence[]

  @@unique([projectId, externalId])
  @@index([tenantId, projectId, status, scheduledFor])
  @@index([checkpointId, status])
  @@index([wbsNodeId, status])
  @@index([bimElementId, status])
}

model CommissioningEvidence {
  id                String            @id @default(uuid())
  tenantId          String
  commissioningTestId String
  documentVersionId String
  addedById         String
  note              String?
  createdAt         DateTime          @default(now())
  commissioningTest CommissioningTest @relation(fields: [commissioningTestId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion   @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  addedBy           User              @relation("CommissioningEvidenceAdder", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([commissioningTestId, documentVersionId])
  @@index([tenantId, commissioningTestId])
}

model HandoverPackage {
  id             String                @id @default(uuid())
  tenantId       String
  projectId      String
  wbsNodeId      String
  bimElementId   String?
  externalId     String
  name           String
  system         String
  status         HandoverPackageStatus @default(DRAFT)
  createdById    String
  reviewedById   String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewComment  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode        WbsNode               @relation(fields: [wbsNodeId], references: [id], onDelete: Restrict)
  bimElement     BimElement?           @relation(fields: [bimElementId], references: [id], onDelete: SetNull)
  createdBy      User                  @relation("HandoverPackageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy     User?                 @relation("HandoverPackageReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  requirements   HandoverRequirement[]

  @@unique([projectId, externalId])
  @@index([tenantId, projectId, status])
  @@index([wbsNodeId, status])
  @@index([bimElementId, status])
}

model HandoverRequirement {
  id                String                    @id @default(uuid())
  tenantId          String
  handoverPackageId String
  code              String
  title             String
  documentType      String
  status            HandoverRequirementStatus @default(MISSING)
  documentVersionId String?
  providedById      String?
  providedAt        DateTime?
  note              String?
  sortOrder         Int                       @default(0)
  handoverPackage   HandoverPackage           @relation(fields: [handoverPackageId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion?          @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  providedBy        User?                     @relation("HandoverRequirementProvider", fields: [providedById], references: [id], onDelete: Restrict)

  @@unique([handoverPackageId, code])
  @@index([tenantId, handoverPackageId, status])
  @@index([documentVersionId])
}
