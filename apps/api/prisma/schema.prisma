generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum DevelopmentPhaseStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum UnitStatus {
  DRAFT
  UNRELEASED
  AVAILABLE
  HELD
  RESERVED
  SOLD
  BLOCKED
  WITHDRAWN
}

enum UnitPriceRevisionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  WITHDRAWN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT
  NEGOTIATION
  RESERVED
  WON
  LOST
  DISQUALIFIED
}

enum SalesActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  SITE_VISIT
  FOLLOW_UP
  NOTE
}

enum WorkflowStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  APPROVED
  COMPLETED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum UploadStatus {
  PENDING
  UPLOADED
  FAILED
}

enum ReviewDecision {
  PENDING
  APPROVED
  RETURNED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum BimModelStatus {
  PENDING
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum BimJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum BimSpatialType {
  PROJECT
  SITE
  BUILDING
  STOREY
  SPACE
  ZONE
  OTHER
}

enum BimArtifactStatus {
  PENDING
  UPLOADED
  FAILED
}

enum ProgressStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum ScheduleDependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum BudgetStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum CostEntryType {
  COMMITMENT
  ACTUAL
}

enum MaterialStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum MaterialTakeoffStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum MaterialTakeoffSource {
  MANUAL
  BIM
  SAP
}

enum ProcurementOrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum MaterialMovementType {
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum QualityPlanStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum QualityInspectionStatus {
  SCHEDULED
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum QualityInspectionResult {
  PASS
  FAIL
  CONDITIONAL
  NOT_APPLICABLE
}

enum QualityFindingType {
  NCR
  PUNCH
  OBSERVATION
}

enum QualityFindingSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum QualityFindingStatus {
  OPEN
  ACTIONED
  READY_FOR_VERIFICATION
  CLOSED
  VOID
}

enum QualityActionStatus {
  OPEN
  COMPLETED
  VERIFIED
}

enum SafetyPermitType {
  HOT_WORK
  CONFINED_SPACE
  EXCAVATION
  LIFTING
  ELECTRICAL
  WORK_AT_HEIGHT
  GENERAL
}

enum SafetyPermitStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACTIVE
  SUSPENDED
  CLOSED
  CANCELLED
}

enum SafetyEventType {
  HAZARD
  OBSERVATION
  NEAR_MISS
  INCIDENT
}

enum SafetySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SafetyEventStatus {
  OPEN
  UNDER_INVESTIGATION
  ACTIONED
  READY_FOR_CLOSURE
  CLOSED
  VOID
}

enum SafetyActionStatus {
  OPEN
  COMPLETED
  VERIFIED
}

enum CommissioningPlanStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum CommissioningTestStatus {
  SCHEDULED
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum CommissioningTestResult {
  PASS
  FAIL
  CONDITIONAL
  NOT_APPLICABLE
}

enum HandoverPackageStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  RETURNED
}

enum HandoverRequirementStatus {
  MISSING
  PROVIDED
  ACCEPTED
  REJECTED
}

model Tenant {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships TenantMembership[]
  roles       Role[]
  projects    Project[]
  auditEvents     AuditEvent[]
  documents       Document[]
  notifications   NotificationOutbox[]
  developmentPhases DevelopmentPhase[]
  buildings         Building[]
  floors            Floor[]
  unitTypes         UnitType[]
  units             Unit[]
  unitPriceRevisions UnitPriceRevision[]
  paymentPlans       PaymentPlan[]
  paymentPlanInstallments PaymentPlanInstallment[]
  projectMedia       ProjectMedia[]
  buildingMedia      BuildingMedia[]
  unitMedia          UnitMedia[]
  customers          Customer[]
  leads              Lead[]
  salesActivities    SalesActivity[]
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  displayName   String
  passwordHash  String
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   TenantMembership[]
  projectAccess ProjectMember[]
  refreshTokens RefreshToken[]
  auditEvents         AuditEvent[]          @relation("AuditActor")
  uploadedVersions    DocumentVersion[]      @relation("VersionUploader")
  documentComments    DocumentComment[]
  documentReviews     DocumentReview[]
  distributions       DocumentDistribution[] @relation("Distributor")
  notifications       NotificationOutbox[]   @relation("NotificationRecipient")
  bimLinks            BimWbsLink[]           @relation("BimLinkActor")
  progressReports     WbsProgressUpdate[]     @relation("ProgressReporter")
  progressReviews     WbsProgressUpdate[]     @relation("ProgressReviewer")
  schedulesCreated    ProjectSchedule[]        @relation("ScheduleCreator")
  budgetsCreated      ProjectBudget[]          @relation("BudgetCreator")
  costEntriesCreated       CostLedgerEntry[]   @relation("CostEntryCreator")
  materialTakeoffsCreated  MaterialTakeoff[]   @relation("MaterialTakeoffCreator")
  procurementOrdersCreated ProcurementOrder[]  @relation("ProcurementOrderCreator")
  materialMovementsCreated MaterialMovement[]  @relation("MaterialMovementCreator")
  qualityPlansCreated      QualityPlan[]       @relation("QualityPlanCreator")
  inspectionsPerformed    QualityInspection[] @relation("InspectionPerformer")
  inspectionsReviewed     QualityInspection[] @relation("InspectionReviewer")
  qualityFindingsRaised   QualityFinding[]    @relation("FindingRaiser")
  qualityFindingsClosed   QualityFinding[]    @relation("FindingCloser")
  qualityActionsAssigned  QualityAction[]     @relation("QualityActionAssignee")
  qualityActionsCompleted QualityAction[]     @relation("QualityActionCompleter")
  qualityActionsVerified  QualityAction[]     @relation("QualityActionVerifier")
  qualityEvidenceAdded    QualityEvidence[]   @relation("QualityEvidenceAdder")
  safetyPermitsRequested   SafetyPermit[]      @relation("SafetyPermitRequester")
  safetyPermitsReviewed    SafetyPermit[]      @relation("SafetyPermitReviewer")
  safetyPermitsActivated   SafetyPermit[]      @relation("SafetyPermitActivator")
  safetyPermitsClosed      SafetyPermit[]      @relation("SafetyPermitCloser")
  safetyEventsReported     SafetyEvent[]       @relation("SafetyEventReporter")
  safetyEventsInvestigated SafetyEvent[]       @relation("SafetyEventInvestigator")
  safetyEventsClosed       SafetyEvent[]       @relation("SafetyEventCloser")
  safetyActionsAssigned    SafetyAction[]      @relation("SafetyActionAssignee")
  safetyActionsCompleted   SafetyAction[]      @relation("SafetyActionCompleter")
  safetyActionsVerified    SafetyAction[]      @relation("SafetyActionVerifier")
  safetyEvidenceAdded      SafetyEvidence[]    @relation("SafetyEvidenceAdder")
  commissioningPlansCreated CommissioningPlan[] @relation("CommissioningPlanCreator")
  commissioningTestsPerformed CommissioningTest[] @relation("CommissioningTestPerformer")
  commissioningTestsReviewed  CommissioningTest[] @relation("CommissioningTestReviewer")
  commissioningEvidenceAdded  CommissioningEvidence[] @relation("CommissioningEvidenceAdder")
  handoverPackagesCreated      HandoverPackage[] @relation("HandoverPackageCreator")
  handoverPackagesReviewed     HandoverPackage[] @relation("HandoverPackageReviewer")
  handoverRequirementsProvided HandoverRequirement[] @relation("HandoverRequirementProvider")
  unitPriceRevisionsCreated UnitPriceRevision[] @relation("UnitPriceRevisionCreator")
  assignedLeads             Lead[]              @relation("LeadAssignee")
  salesActivities           SalesActivity[]     @relation("SalesActivityActor")
}

model Role {
  id          String       @id @default(uuid())
  tenantId    String
  code        String
  name        String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id    String @id @default(uuid())
  code  String @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model TenantMembership {
  tenantId String
  userId   String
  roleId   String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([tenantId, userId])
  @@index([roleId])
}

model Project {
  id          String        @id @default(uuid())
  tenantId    String
  code        String
  name        String
  description String?
  status      ProjectStatus @default(DRAFT)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  wbsNodes    WbsNode[]
  workItems   WorkItem[]
  documents   Document[]
  bimModels        BimModel[]
  schedules        ProjectSchedule[] @relation("ProjectSchedules")
  activeScheduleId String?            @unique
  activeSchedule   ProjectSchedule?   @relation("ActiveProjectSchedule", fields: [activeScheduleId], references: [id], onDelete: SetNull)
  budgets          ProjectBudget[]     @relation("ProjectBudgets")
  activeBudgetId   String?             @unique
  activeBudget     ProjectBudget?      @relation("ActiveProjectBudget", fields: [activeBudgetId], references: [id], onDelete: SetNull)
  costEntries      CostLedgerEntry[]
  materialTakeoffs MaterialTakeoff[] @relation("ProjectMaterialTakeoffs")
  activeMaterialTakeoffId String?     @unique
  activeMaterialTakeoff MaterialTakeoff? @relation("ActiveMaterialTakeoff", fields: [activeMaterialTakeoffId], references: [id], onDelete: SetNull)
  procurementOrders ProcurementOrder[]
  inventoryLocations InventoryLocation[]
  materialMovements MaterialMovement[]
  qualityPlans      QualityPlan[] @relation("ProjectQualityPlans")
  activeQualityPlanId String?     @unique
  activeQualityPlan QualityPlan?  @relation("ActiveQualityPlan", fields: [activeQualityPlanId], references: [id], onDelete: SetNull)
  qualityInspections QualityInspection[]
  qualityFindings    QualityFinding[]
  safetyPermits      SafetyPermit[]
  safetyEvents       SafetyEvent[]
  commissioningPlans CommissioningPlan[] @relation("ProjectCommissioningPlans")
  activeCommissioningPlanId String? @unique
  activeCommissioningPlan CommissioningPlan? @relation("ActiveCommissioningPlan", fields: [activeCommissioningPlanId], references: [id], onDelete: SetNull)
  commissioningTests CommissioningTest[]
  handoverPackages  HandoverPackage[]
  developmentPhases DevelopmentPhase[]
  buildings         Building[]
  unitTypes         UnitType[]
  units             Unit[]
  paymentPlans      PaymentPlan[]
  projectMedia      ProjectMedia[]
  leads             Lead[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model DevelopmentPhase {
  id                     String                 @id @default(uuid())
  tenantId               String
  projectId              String
  code                   String
  name                   String
  description            String?
  status                 DevelopmentPhaseStatus @default(DRAFT)
  sequence               Int                    @default(0)
  launchDate             DateTime?
  expectedCompletionDate DateTime?
  salesOpenAt            DateTime?
  salesCloseAt           DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project                Project                @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  buildings              Building[]
  units                  Unit[]

  @@unique([projectId, code])
  @@unique([id, projectId, tenantId])
  @@index([tenantId, projectId, status, sequence])
}

model Building {
  id        String   @id @default(uuid())
  tenantId  String
  projectId String
  phaseId   String
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  phase     DevelopmentPhase @relation(fields: [phaseId, projectId, tenantId], references: [id, projectId, tenantId], onDelete: Restrict)
  floors    Floor[]
  units     Unit[]
  media     BuildingMedia[]

  @@unique([projectId, code])
  @@unique([id, projectId, tenantId])
  @@unique([id, projectId, phaseId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, projectId, phaseId])
}

model Floor {
  id          String   @id @default(uuid())
  tenantId    String
  buildingId  String
  code        String
  name        String
  floorNumber Int
  sequence    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  building    Building @relation(fields: [buildingId, tenantId], references: [id, tenantId], onDelete: Cascade)
  units       Unit[]

  @@unique([buildingId, code])
  @@unique([buildingId, floorNumber])
  @@unique([id, buildingId, tenantId])
  @@index([tenantId, buildingId, sequence])
}

model UnitType {
  id          String   @id @default(uuid())
  tenantId    String
  projectId   String
  code        String
  name        String
  bedrooms    Int
  bathrooms   Int
  defaultArea Decimal? @db.Decimal(12, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  units       Unit[]

  @@unique([projectId, code])
  @@unique([id, projectId, tenantId])
  @@index([tenantId, projectId])
}

model Unit {
  id           String     @id @default(uuid())
  tenantId     String
  projectId    String
  phaseId      String
  buildingId   String
  floorId      String
  unitTypeId   String
  code         String
  number       String
  status       UnitStatus @default(DRAFT)
  grossArea    Decimal    @db.Decimal(12, 2)
  netArea      Decimal?   @db.Decimal(12, 2)
  bedrooms     Int
  bathrooms    Int
  orientation  String?
  view         String?
  parkingCount Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      Project    @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  phase        DevelopmentPhase @relation(fields: [phaseId, projectId, tenantId], references: [id, projectId, tenantId], onDelete: Restrict)
  building     Building   @relation(fields: [buildingId, projectId, phaseId, tenantId], references: [id, projectId, phaseId, tenantId], onDelete: Restrict)
  floor        Floor      @relation(fields: [floorId, buildingId, tenantId], references: [id, buildingId, tenantId], onDelete: Restrict)
  unitType     UnitType   @relation(fields: [unitTypeId, projectId, tenantId], references: [id, projectId, tenantId], onDelete: Restrict)
  priceRevisions UnitPriceRevision[]
  media        UnitMedia[]
  leads        Lead[]

  @@unique([projectId, code])
  @@unique([floorId, number])
  @@unique([id, tenantId])
  @@index([tenantId, projectId, phaseId, buildingId, floorId])
  @@index([tenantId, projectId, status, unitTypeId])
}

model Customer {
  id              String   @id @default(uuid())
  tenantId        String
  firstName       String
  lastName        String?
  phone           String   @db.VarChar(32)
  phoneNormalized String   @db.VarChar(32)
  email           String   @db.VarChar(320)
  emailNormalized String   @db.VarChar(320)
  dedupReviewRequired Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads           Lead[]

  @@unique([tenantId, phoneNormalized, emailNormalized])
  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
}

model Lead {
  id                       String     @id @default(uuid())
  tenantId                 String
  customerId               String?
  projectId                String?
  unitId                   String?
  assignedToId             String
  source                   String
  status                   LeadStatus @default(NEW)
  isExternalEnquiry        Boolean    @default(false)
  enquiryConsentGranted    Boolean    @default(false)
  enquiryConsentAt         DateTime?
  enquiryConsentChannel    String?
  enquiryConsentPurpose    String?
  marketingConsentGranted  Boolean    @default(false)
  marketingConsentAt       DateTime?
  marketingConsentChannel  String?
  marketingConsentPurpose  String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  tenant                   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer                 Customer?  @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project                  Project?   @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  unit                     Unit?      @relation(fields: [unitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignedTo               User       @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  activities               SalesActivity[]

  @@unique([id, tenantId])
  @@index([tenantId, assignedToId, status, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, projectId, unitId])
}

model SalesActivity {
  id        String            @id @default(uuid())
  tenantId  String
  leadId    String
  actorId   String
  type      SalesActivityType
  notes     String            @db.Text
  createdAt DateTime          @default(now())
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead      Lead              @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  actor     User              @relation("SalesActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, leadId, createdAt])
}

model UnitPriceRevision {
  id             String                  @id @default(uuid())
  tenantId       String
  unitId         String
  revision       Int
  basePriceMinor BigInt
  listPriceMinor BigInt
  currency       String                  @db.VarChar(3)
  validFrom      DateTime?
  validTo        DateTime?
  status         UnitPriceRevisionStatus @default(DRAFT)
  createdById    String
  publishedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit                    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy      User                    @relation("UnitPriceRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([unitId, revision])
  @@index([tenantId, unitId, status, validFrom])
}

model PaymentPlan {
  id           String                   @id @default(uuid())
  tenantId     String
  projectId    String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      Project                  @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  installments PaymentPlanInstallment[]

  @@index([tenantId, projectId])
}

model PaymentPlanInstallment {
  id              String      @id @default(uuid())
  tenantId        String
  paymentPlanId   String
  sequence        Int
  shareBasisPoints Int
  label           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentPlan     PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@unique([paymentPlanId, sequence])
  @@index([tenantId, paymentPlanId, sequence])
}

model ProjectMedia {
  id                String          @id @default(uuid())
  tenantId          String
  projectId         String
  documentVersionId String
  sortOrder         Int?
  createdAt         DateTime        @default(now())
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project           Project         @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([projectId, documentVersionId])
  @@index([tenantId, projectId, sortOrder, createdAt])
}

model BuildingMedia {
  id                String          @id @default(uuid())
  tenantId          String
  buildingId        String
  documentVersionId String
  sortOrder         Int?
  createdAt         DateTime        @default(now())
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  building          Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([buildingId, documentVersionId])
  @@index([tenantId, buildingId, sortOrder, createdAt])
}

model UnitMedia {
  id                String          @id @default(uuid())
  tenantId          String
  unitId            String
  documentVersionId String
  sortOrder         Int?
  createdAt         DateTime        @default(now())
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit              Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([unitId, documentVersionId])
  @@index([tenantId, unitId, sortOrder, createdAt])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model WbsNode {
  id          String    @id @default(uuid())
  tenantId    String
  projectId   String
  parentId    String?
  code        String
  name        String
  sortOrder   Int       @default(0)
  plannedFrom DateTime?
  plannedTo   DateTime?
  weight      Decimal   @default(0) @db.Decimal(8, 4)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      WbsNode?  @relation("WbsHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    WbsNode[] @relation("WbsHierarchy")
  workItems   WorkItem[]
  bimLinks           BimWbsLink[]
  progressUpdates    WbsProgressUpdate[]
  scheduleActivities ScheduleActivity[]
  budgetLines        BudgetLine[]
  costEntries        CostLedgerEntry[]
  materialTakeoffLines MaterialTakeoffLine[]
  procurementLines    ProcurementOrderLine[]
  materialMovements   MaterialMovement[]
  qualityCheckpoints   QualityCheckpoint[]
  qualityInspections   QualityInspection[]
  qualityFindings      QualityFinding[]
  safetyPermits        SafetyPermit[]
  safetyEvents         SafetyEvent[]
  commissioningCheckpoints CommissioningCheckpoint[]
  commissioningTests CommissioningTest[]
  handoverPackages    HandoverPackage[]

  @@unique([projectId, code])
  @@index([tenantId, projectId, parentId])
}

model WorkItem {
