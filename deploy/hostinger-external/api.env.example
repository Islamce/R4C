# R4C API — Hostinger Cloud Startup non-production template
#
# This is a names-and-placeholders template, not a deployable secrets file.
# Do not commit populated values. Keep actual values only in the relevant
# provider account and the Hostinger Web App environment-variable interface.
#
# No region has been chosen. Do not create a provider resource until the C03
# PDPL/data-residency decision identifies the region and data classification.

NODE_ENV=production

# Hostinger normally supplies PORT. The API honors PORT when API_PORT is absent.
# Set API_PORT only if hPanel explicitly requires a named port value.
# API_PORT=<HOSTINGER_CONFIRMED_PORT>

# Exact temporary non-production browser origin only; do not use production DNS.
CORS_ORIGINS=https://<TEMPORARY_NONPRODUCTION_WEB_HOST>

# Neon: pooled URL for application queries. Keep SSL required. The pool limits
# are starting placeholders and must be measured against Hostinger concurrency.
DATABASE_URL=postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_POOLED_HOST>/<NEON_DATABASE>?sslmode=require&connect_timeout=15&connection_limit=<MEASURED_CONNECTION_LIMIT>&pool_timeout=15

# Neon: direct URL used only by Prisma CLI migration commands. R4C Prisma 6
# reads this through datasource directUrl; never expose it to the web client.
DIRECT_URL=postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_DIRECT_HOST>/<NEON_DATABASE>?sslmode=require&connect_timeout=15

# Upstash Redis: R4C uses ioredis/BullMQ TCP/TLS, not the Upstash REST client.
# Use the provider Endpoint, Port, and Token/password to form this URL.
REDIS_URL=rediss://:<UPSTASH_REDIS_TOKEN>@<UPSTASH_REDIS_ENDPOINT>:<UPSTASH_REDIS_PORT>

# Required C04 expiry cadence. There is intentionally no runtime code default.
HOLD_EXPIRY_SWEEP_INTERVAL_MS=300000

# Cloudflare R2 private-bucket S3 API. `auto` is the SDK region; it is not a
# data-location decision. For a later jurisdiction bucket, use the provider's
# jurisdiction-specific endpoint only after the residency decision is approved.
S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_PRESIGN_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<PRIVATE_R2_BUCKET_NAME>
S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>

# Generate separate high-entropy non-production secrets in an approved secret
# manager. Never reuse local or production values.
JWT_ACCESS_SECRET=<NONPRODUCTION_HIGH_ENTROPY_ACCESS_SECRET>
JWT_REFRESH_SECRET=<NONPRODUCTION_HIGH_ENTROPY_REFRESH_SECRET>

# Hostinger Email SMTP for expiring password-reset links.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@kynox.io
SMTP_PASSWORD=<HOSTINGER_MAILBOX_PASSWORD>
SMTP_FROM=no-reply@kynox.io
WEB_APP_URL=https://<TEMPORARY_NONPRODUCTION_WEB_HOST>

# Frozen Development Intelligence boundary. Leave disabled. Do not enter fake
# endpoint/token values. A real BIM runtime requires separate Founder approval.
BIM_ENABLED=false
BIM_WORKER_URL=
BIM_WORKER_TOKEN=
BIM_MAX_ELEMENTS=250000
BIM_MAX_FILE_BYTES=1073741824

# Existing application rate/proxy configuration. Adjust only after measured use.
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_AUTH_SESSION_PER_MINUTE=20
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=3
RATE_LIMIT_TENANT_LOOKUP_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_SEARCH_EXPORT_PER_MINUTE=30
TRUST_PROXY_HOPS=<HOSTINGER_PROXY_HOP_COUNT_TO_VERIFY>
