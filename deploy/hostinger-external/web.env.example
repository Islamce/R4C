# R4C Web — Hostinger Cloud Startup non-production template
#
# This is a names-and-placeholders template, not a deployable secrets file.
# Do not commit populated values. Set build-visible values before the Next.js
# build and keep runtime values in the Hostinger Web App configuration.

NODE_ENV=production

# Hostinger normally supplies PORT to the Next.js standalone server.
# Set PORT only if hPanel explicitly requires it.
# PORT=<HOSTINGER_CONFIRMED_PORT>

# The server resolves API_URL first; the browser bundle uses NEXT_PUBLIC_API_URL.
# Both must use the temporary non-production API origin and `/api/v1` prefix.
API_URL=https://<TEMPORARY_NONPRODUCTION_API_HOST>/api/v1
NEXT_PUBLIC_API_URL=https://<TEMPORARY_NONPRODUCTION_API_HOST>/api/v1

# Do not choose a region or final domain here. This is a temporary placeholder
# pending the C03 PDPL/data-residency decision and explicit DNS authorization.
TENANT_BASE_DOMAIN=<TEMPORARY_NONPRODUCTION_BASE_DOMAIN>
TENANT_DEFAULT_CODE=<SYNTHETIC_NONPRODUCTION_TENANT_CODE>
SEED_UAT_TENANT_CODE=<SYNTHETIC_NONPRODUCTION_TENANT_CODE>
SEED_UAT_TENANT_NAME_AR=<APPROVED_SYNTHETIC_ARABIC_TENANT_NAME>
