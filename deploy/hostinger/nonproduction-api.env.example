# R4C API — non-production Hostinger Web App template
#
# This file contains variable names and placeholders only.
# Never commit a populated copy. Enter real values only in the approved provider
# and Hostinger secret-management interfaces after a Founder decision at G0/G1.
#
# This template does not authorize deployment, external resource creation, or a
# production traffic change. See docs/nonproduction-hostinger-web-app-qualification.md.

NODE_ENV=production

# Set to the inbound port contract explicitly confirmed by Hostinger for this Web App.
# The API source otherwise defaults to 4000; do not guess the managed platform port.
API_PORT=<HOSTINGER_CONFIRMED_API_PORT>

# Exact temporary non-production Web App origin(s), comma-separated. Do not use a
# production hostname or wildcard here until its route and TLS behavior are proven.
CORS_ORIGINS=https://<TEMPORARY_NONPROD_WEB_HOST>

# Isolated PostgreSQL project only. Use a persistent-server-compatible connection
# string verified from the Hostinger Web App; never use production data.
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require

# Required by Commercial hold expiry and by currently unconditional BIM queue
# clients. Must be a real TCP/TLS endpoint; do not provide a mock or fake URL.
REDIS_URL=rediss://:<PASSWORD>@<HOST>:<PORT>

# Required S3-compatible private bucket configuration. The current R4C client
# uses path-style addressing and presigned PUT/GET URLs.
S3_BUCKET=<PRIVATE_NONPRODUCTION_BUCKET>
S3_ACCESS_KEY=<S3_ACCESS_KEY>
S3_SECRET_KEY=<S3_SECRET_KEY>
S3_ENDPOINT=https://<S3_API_ENDPOINT>
S3_PRESIGN_ENDPOINT=https://<S3_PRESIGN_ENDPOINT>
S3_REGION=us-east-1

# Generate a distinct high-entropy non-production secret in an approved secret
# manager. Never reuse a local or production JWT secret.
JWT_ACCESS_SECRET=<NONPRODUCTION_HIGH_ENTROPY_SECRET>

# Required configuration; there is intentionally no code default. 300000 ms is
# the approved initial operational value for a five-minute expiry sweep.
HOLD_EXPIRY_SWEEP_INTERVAL_MS=300000

# These are mandatory because BimModule currently initializes with the API.
# Do not set placeholder or unrelated-service values. Leave this deployment
# blocked until a real BIM component is approved and testable, or an explicitly
# authorized architecture change makes BIM optional.
BIM_WORKER_URL=<APPROVED_REAL_BIM_WORKER_URL>
BIM_WORKER_TOKEN=<APPROVED_REAL_BIM_WORKER_TOKEN>
