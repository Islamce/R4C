# R4C Web — non-production Hostinger Web App template
#
# This file contains variable names and placeholders only.
# Never commit a populated copy. Enter real values only in the approved Hostinger
# secret-management interface after a Founder decision at G0/G1.
#
# This template does not authorize deployment, external resource creation, or a
# production traffic change. See docs/nonproduction-hostinger-web-app-qualification.md.

NODE_ENV=production

# Hostinger must confirm this process port contract before deployment. The Next.js
# standalone runtime defaults to 3000 if PORT is absent.
PORT=<HOSTINGER_CONFIRMED_WEB_PORT>

# The Next.js server resolves API_URL first, then NEXT_PUBLIC_API_URL. Both must
# point to the exact temporary non-production API route. NEXT_PUBLIC_API_URL is
# build-visible and must be available when `pnpm --filter @r4c/web build` runs.
API_URL=https://<TEMPORARY_NONPROD_API_HOST>/api/v1
NEXT_PUBLIC_API_URL=https://<TEMPORARY_NONPROD_API_HOST>/api/v1

# Keep tenant handling to a single explicit temporary hostname until wildcard
# routing/certificates are separately tested. Do not reuse a production domain.
TENANT_BASE_DOMAIN=<TEMPORARY_NONPROD_BASE_DOMAIN>

# Optional only for the existing UAT naming helper. Do not add personal or
# production tenant data here.
TENANT_DEFAULT_CODE=<SYNTHETIC_NONPRODUCTION_TENANT_CODE>
SEED_UAT_TENANT_CODE=<SYNTHETIC_NONPRODUCTION_TENANT_CODE>
SEED_UAT_TENANT_NAME_AR=<APPROVED_SYNTHETIC_ARABIC_TENANT_NAME>
